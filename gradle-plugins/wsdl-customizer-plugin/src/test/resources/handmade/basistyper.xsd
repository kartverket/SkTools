<?xml version="1.0" encoding="UTF-8"?>
<xs:schema
        version="1.0"
        targetNamespace="http://statkart.no/sktools/wsapi/v1/domain/basistyper"
        xmlns:basistyperns="http://statkart.no/sktools/wsapi/v1/domain/basistyper"
        xmlns:xs="http://www.w3.org/2001/XMLSchema"
        elementFormDefault="qualified">

    <!-- ========================================================= -->
    <!-- Basisklasser:                                             -->
    <!-- Frittstående klasser og klasser på tvers av subdomains    -->
    <!-- ========================================================= -->

    <xs:complexType name="Timestamp">
        <xs:sequence>
            <xs:element name="timestamp" type="xs:dateTime"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="LocalTime">
        <xs:sequence>
            <xs:element name="time" type="xs:time"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="LocalDate">
        <xs:sequence>
            <xs:element name="date" type="xs:date"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="LocalDateTime">
        <xs:sequence>
            <xs:element name="dateTime" type="xs:dateTime"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="SkToolsContext">
        <xs:sequence>
            <xs:element name="apiVersion" type="xs:string"/>
            <xs:element name="clientIdentification" type="xs:string"/>
            <xs:element name="locale" type="xs:string"/>
            <xs:element name="snapshotVersion" type="basistyperns:Timestamp"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="StringList">
        <xs:sequence>
            <xs:element minOccurs="0" maxOccurs="unbounded" name="item" type="xs:string"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="LocalizedString">
        <xs:annotation>
            <xs:appinfo>
                <IsDictionary
                        xmlns="http://schemas.microsoft.com/2003/10/Serialization/">
                    true
                </IsDictionary>
            </xs:appinfo>
        </xs:annotation>
        <xs:sequence>
            <xs:element minOccurs="0" maxOccurs="unbounded" name="entry">
                <xs:complexType>
                    <xs:sequence>
                        <xs:element name="key" nillable="true" type="xs:string"/>
                        <xs:element name="value" type="xs:string"/>
                    </xs:sequence>
                </xs:complexType>
            </xs:element>
        </xs:sequence>
    </xs:complexType>

    <!-- SkToolsBubbleObject -->

    <xs:complexType name="SkToolsBubbleObjectIdent"/>

    <xs:complexType name="SkToolsBubbleObjectIdentList">
        <xs:sequence>
            <xs:element minOccurs="0" maxOccurs="unbounded" name="item" type="basistyperns:SkToolsBubbleObjectIdent"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="SkToolsBubbleObjectId">
        <xs:sequence>
            <xs:element name="value" type="xs:string"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="SkToolsBubbleObjectIdList">
        <xs:sequence>
            <xs:element minOccurs="0" maxOccurs="unbounded" name="item" type="basistyperns:SkToolsBubbleObjectId"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="SnapshotVersionToSkToolsBubbleObjectIdMap">
        <!--<xs:annotation>-->
        <!--<xs:appinfo>-->
        <!--<IsDictionary-->
        <!--xmlns="http://schemas.microsoft.com/2003/10/Serialization/">-->
        <!--true-->
        <!--</IsDictionary>-->
        <!--</xs:appinfo>-->
        <!--</xs:annotation>-->
        <xs:sequence>
            <xs:element minOccurs="0" maxOccurs="unbounded" name="entry">
                <xs:complexType>
                    <xs:sequence>
                        <xs:element name="key" type="basistyperns:Timestamp"/>
                        <xs:element name="value" type="basistyperns:SkToolsBubbleObjectId"/>
                    </xs:sequence>
                </xs:complexType>
            </xs:element>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="SkToolsBubbleObjectIdToSnapshotBubbleIdsMap">
        <xs:annotation>
            <xs:appinfo>
                <IsDictionary
                        xmlns="http://schemas.microsoft.com/2003/10/Serialization/">
                    true
                </IsDictionary>
            </xs:appinfo>
        </xs:annotation>
        <xs:sequence>
            <xs:element minOccurs="0" maxOccurs="unbounded" name="entry">
                <xs:complexType>
                    <xs:sequence>
                        <xs:element name="key" nillable="true" type="basistyperns:SkToolsBubbleObjectId"/>
                        <xs:element name="value" type="basistyperns:SnapshotVersionToSkToolsBubbleObjectIdMap"/>
                    </xs:sequence>
                </xs:complexType>
            </xs:element>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="SkToolsBubbleObject">
        <xs:sequence>
            <xs:element name="id" type="basistyperns:SkToolsBubbleObjectId"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="SkToolsBubbleObjectList">
        <xs:sequence>
            <xs:element minOccurs="0" maxOccurs="unbounded" name="item" type="basistyperns:SkToolsBubbleObject"/>
        </xs:sequence>
    </xs:complexType>

    <!-- SkToolsObjectWithVersion -->

    <xs:complexType name="SkToolsObjectWithVersionId">
        <xs:complexContent>
            <xs:extension base="basistyperns:SkToolsBubbleObjectId">
            </xs:extension>
        </xs:complexContent>
    </xs:complexType>

    <xs:complexType name="SkToolsObjectWithVersion">
        <xs:complexContent>
            <xs:extension base="basistyperns:SkToolsBubbleObject">
                <xs:sequence>
                    <!-- TODO oppdateringsdato skal egentlig ikke være nillable, men løser et problem jf. GBOK-2406 -->
                    <xs:element name="oppdateringsdato" type="basistyperns:Timestamp" nillable="true"/>
                </xs:sequence>
            </xs:extension>
        </xs:complexContent>
    </xs:complexType>

    <!-- SkToolsObjectWithHistory -->

    <xs:complexType name="SkToolsObjectWithHistoryId">
        <xs:complexContent>
            <xs:extension base="basistyperns:SkToolsObjectWithVersionId">
            </xs:extension>
        </xs:complexContent>
    </xs:complexType>

    <xs:complexType name="SkToolsObjectWithHistory">
        <xs:complexContent>
            <xs:extension base="basistyperns:SkToolsObjectWithVersion">
                <xs:sequence>
                    <!-- TODO sluttdato skal egentlig ikke være nillable, men løser et problem jf. GBOK-2406 -->
                    <xs:element name="sluttdato" type="basistyperns:Timestamp" nillable="true"/>
                    <xs:element name="oppdateringsBruker" type="xs:string" nillable="true"/>
                    <xs:element name="incrementalVersion" type="xs:long" nillable="false"/>
                    <xs:element name="versjon" type="xs:long" nillable="false"/>
                </xs:sequence>
            </xs:extension>
        </xs:complexContent>
    </xs:complexType>

    <xs:complexType name="EntityComponent">
        <xs:sequence>
            <!-- GBOK-2401: nillable for ikke primitiver verdier -->
            <xs:element name="id" type="xs:long" nillable="true"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="EntityComponentWithHistory">
        <xs:complexContent>
            <xs:extension base="basistyperns:EntityComponent">
                <xs:sequence>
                    <xs:element name="oppdateringsdato" type="basistyperns:Timestamp" nillable="true"/>
                    <xs:element name="sluttdato" type="basistyperns:Timestamp" nillable="true"/>
                </xs:sequence>
            </xs:extension>
        </xs:complexContent>
    </xs:complexType>

    <xs:complexType name="InverseRelation">
        <xs:sequence>
            <xs:element name="materialised" type="xs:boolean"/>
        </xs:sequence>
    </xs:complexType>

</xs:schema>
