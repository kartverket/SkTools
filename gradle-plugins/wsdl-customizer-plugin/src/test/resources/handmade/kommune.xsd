<?xml version="1.0" encoding="ISO-8859-1"?>
<xs:schema
        xmlns:registerns="http://statkart.no/sktools/wsapi/v1/domain/register"
        xmlns:basistyperns="http://statkart.no/sktools/wsapi/v1/domain/basistyper"
        xmlns:xs="http://www.w3.org/2001/XMLSchema"
        version="1.0"
        targetNamespace="http://statkart.no/sktools/wsapi/v1/domain/register"
        elementFormDefault="qualified">

    <xs:import schemaLocation="basistyper.xsd" namespace="http://statkart.no/sktools/wsapi/v1/domain/basistyper"/>

    <!-- ========================================================= -->
    <!-- register:                                                 -->
    <!-- Fellesklasser i register subdomain                        -->
    <!-- ========================================================= -->

    <!-- Kommune -->

    <xs:complexType name="KommuneId">
        <xs:complexContent>
            <xs:extension base="basistyperns:SkToolsObjectWithHistoryId">
            </xs:extension>
        </xs:complexContent>
    </xs:complexType>

    <xs:complexType name="KommuneIdList">
        <xs:sequence>
            <xs:element minOccurs="0" maxOccurs="unbounded" name="item" type="registerns:KommuneId"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="KommuneIdInverseRelation">
        <xs:complexContent>
            <xs:extension base="basistyperns:InverseRelation">
                <xs:sequence>
                    <xs:element name="cachedValue" nillable="true" type="registerns:KommuneId"/>
                </xs:sequence>
            </xs:extension>
        </xs:complexContent>
    </xs:complexType>

    <xs:complexType name="KommuneIdListInverseRelation">
        <xs:complexContent>
            <xs:extension base="basistyperns:InverseRelation">
                <xs:sequence>
                    <xs:element name="cachedValue" nillable="true" type="registerns:KommuneIdList"/>
                </xs:sequence>
            </xs:extension>
        </xs:complexContent>
    </xs:complexType>

    <xs:complexType name="Kommune">
        <xs:complexContent>
            <xs:extension base="basistyperns:SkToolsObjectWithHistory">
                <xs:sequence>
                    <xs:element name="kommunenummer" type="xs:string"/>
                    <xs:element name="navn" type="xs:string"/>
                    <xs:element name="historisk" type="xs:boolean"/>
                </xs:sequence>
            </xs:extension>
        </xs:complexContent>
    </xs:complexType>

    <xs:complexType name="KommuneIdent">
        <xs:complexContent>
            <xs:extension base="basistyperns:SkToolsBubbleObjectIdent">
                <xs:sequence>
                    <xs:element name="kommunenummer" type="xs:string"/>
                </xs:sequence>
            </xs:extension>
        </xs:complexContent>
    </xs:complexType>

    <xs:complexType name="KommuneIdentList">
        <xs:sequence>
            <xs:element minOccurs="0" maxOccurs="unbounded" name="item" type="registerns:KommuneIdent"/>
        </xs:sequence>
    </xs:complexType>

</xs:schema>
